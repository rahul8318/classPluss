# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Client & CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/classpulse_learning_workspace
MONGODB_TEST_URI=mongodb://localhost:27017/classpulse_test

# Authentication & JWT (Shared specification for both backends)
JWT_SECRET=classpulse_super_secret_jwt_key_2026_education_platform
JWT_EXPIRES_IN=7d
JWT_ISSUER=classpulse-auth-service
JWT_AUDIENCE=classpulse-clients

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# AI / LLM Configuration (Gemini or OpenAI compatible)
AI_PROVIDER=custom
GEMINI_API_KEY=
OPENAI_API_KEY=

# Spring Boot Live Classroom Backend URL
SPRING_BOOT_API_URL=http://localhost:8080
